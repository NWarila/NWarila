{
  // Schema for editor validation. Update only when intentionally adopting a new schema.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Renovate config for NWarila/NWarila (GitHub profile repository).
  //
  // This repo has no type-template lineage (it's not a Terraform, Packer,
  // or Ansible consumer), so per org ADR-0004 it does not extend any
  // `github>NWarila/<type-template>` preset. The settings below are
  // explicit per ADR-0004 §Confirmation §5 ("Override discipline") — a
  // minimum baseline rather than an inherited one.
  //
  // Manager scope:
  //   - github-actions: SHA-pin discipline per ADR-0004
  //
  // The repo's CI is minimal (markdownlint + link-check), so the only
  // dependencies tracked here are the third-party Actions used in
  // .github/workflows/ci.yml.

  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],

  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",

  "enabledManagers": [
    "github-actions"
  ],

  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    }
  ]
}
